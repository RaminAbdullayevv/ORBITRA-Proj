# Copy to .env for local overrides.
DATABASE_URL=sqlite:///./orbitra.db
FRONTEND_ORIGIN=http://localhost:5173
# Created by python -m scripts.setup_security; do not commit a real value.
TELEMETRY_HMAC_KEY=
# Set your public HTTPS origin for deployment; keep localhost only for local Vite.
# Change both demo passwords before setting DEMO_LOCAL_ONLY=false.
DEMO_LOCAL_ONLY=true
# Cookies must be Secure for an HTTPS domain.
COOKIE_SECURE=false
# Optional, only for first-time account creation; use manage_users for later changes.
ORBITRA_ADMIN_INITIAL_PASSWORD=
ORBITRA_VIRTUAL_INITIAL_PASSWORD=

